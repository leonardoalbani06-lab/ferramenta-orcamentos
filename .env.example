# Copie pra ".env" (não versionado) e preencha os valores.

# Banco de dados — local dev usa SQLite; em produção (Railway) confirmar
# se já migrou pra Postgres (ver .ai/context/current-state.md).
DATABASE_URL="file:./dev.db"

# Segredo do NextAuth (assina o cookie de sessão). Gere um valor forte, ex:
#   npx auth secret
# ou
#   openssl rand -base64 32
AUTH_SECRET=""

# Usadas só pela seed (`npm run db:seed`) pra criar a primeira conta admin
# — a partir daí o admin cadastra os demais representantes pelo painel
# /admin/representantes, sem precisar mais dessas variáveis.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
